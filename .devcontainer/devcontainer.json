{
  "name": "tf-web-tema",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "API",
      "visibility": "public",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "Prisma.prisma"
      ]
    }
  }
}