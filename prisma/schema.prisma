generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ADM {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senhaHash String
  telefone  String?
  criadoEm  DateTime @default(now())
  cnpj      String

  itens     Item[]
  servicos  Servico[]
}

model Item {
  id        Int       @id @default(autoincrement())
  nome      String
  descricao String
  preco     Decimal
  estoque   Int
  imagemUrl String
  tipo      TipoItem
  criadoEm  DateTime  @default(now())

  admId Int?
  adm   ADM? @relation(fields: [admId], references: [id])
}

model Servico {
  id              Int      @id @default(autoincrement())
  nome            String
  caracteristicas String
  precoEstimado   Decimal?
  criadoEm        DateTime @default(now())

  admId Int?
  adm   ADM? @relation(fields: [admId], references: [id])
}

enum TipoItem {
  CHAPEU_PRONTO
  ITEM_MONTAGEM
}

